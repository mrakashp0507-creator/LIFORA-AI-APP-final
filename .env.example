# ============================================================
# LIFORA AI - ENVIRONMENT CONFIGURATION & RENDER DEPLOYMENT
# ============================================================

# Server Port (Render automatically sets PORT at runtime; default is 3000)
PORT="3000"

# Node Environment ('production' for Render live web service, 'development' locally)
NODE_ENV="production"

# Database Persistence Path
# On Render: Attach a Persistent Disk (e.g. mount path /var/data) and set DATA_DIR="/var/data"
# If not set, defaults to project root ./data folder
DATA_DIR="./data"

# Frontend Deployed URL / CORS Origins
# When deploying Frontend and Backend on separate Render domains, provide frontend origin:
# Example: FRONTEND_URL="https://lifora-app.onrender.com"
# Or allow multiple origins: CORS_ORIGIN="https://lifora-app.onrender.com,http://localhost:3000"
# For unified deployment (same service serving frontend & backend), leave as "*"
CORS_ORIGIN="*"
FRONTEND_URL=""

# Frontend API Base URL
# Leave empty for unified single-service deployment (uses relative /api routes)
# Set to your Render backend Web Service URL if frontend is deployed separately on a Static Site:
# Example: VITE_API_URL="https://lifora-backend.onrender.com"
VITE_API_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Render Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMS OTP Provider: 'MSG91' for production live SMS, or 'MOCK' for demo testing
SMS_PROVIDER="MSG91"

# MSG91 Live SMS Gateway Credentials
# Auth key from MSG91 dashboard (https://control.msg91.com)
MSG91_AUTH_KEY=""
# Approved DLT Flow / OTP Template ID
MSG91_TEMPLATE_ID=""
# Optional dedicated Flow ID for transactional Due-Date and Document-Expiry Reminders (falls back to MSG91_TEMPLATE_ID)
MSG91_REMINDER_FLOW_ID=""
# Approved 6-character DLT Sender ID (Header)
MSG91_SENDER_ID="LIFORA"

# OTP Security & Cooldown Policies
OTP_EXPIRY_SECONDS="600"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="4"

# Firebase Client Configuration for Live Phone Authentication (Web / Android)
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps (Web / Android)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""


